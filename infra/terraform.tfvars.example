name_suffix         = "team42"
admin_source_cidr   = "203.0.113.10/32"
admin_ssh_public_key = "ssh-ed25519 AAAA... labflow"

# Create BCrypt hashes with cost 12. Never commit plaintext passwords or real hashes.
borrower_password_hash   = "$2y$12$replace-with-a-real-hash"
manager_password_hash    = "$2y$12$replace-with-a-real-hash"
technician_password_hash = "$2y$12$replace-with-a-real-hash"

# Register a confidential OAuth application in the RWTH GitLab with scopes
# openid, profile and email. For name_suffix = "team42", use this redirect URI:
# http://labflow-dev-team42.germanywestcentral.cloudapp.azure.com/login/oauth2/code/labflow
oidc_client_id     = "replace-with-gitlab-application-id"
oidc_client_secret = "replace-with-gitlab-application-secret"

# GitLab usernames and role groups can be combined.
oidc_borrower_identities = [
  "zaka41a",
  "lsit-2026/roles/labflow/borrower"
]
oidc_manager_identities = [
  "SaadFihi",
  "lsit-2026/roles/labflow/lab-manager"
]
oidc_technician_identities = [
  "othmane022-jj",
